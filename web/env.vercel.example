# Vercel-deploy env template (Production + Preview)
# This file documents WHAT you must set in `vercel env add` for each environment.
# It is NOT loaded by Next — the actual values live in Vercel project settings.

# === Supabase (PUBLIC; safe to ship to client because of RLS) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# === Supabase (server; never prefix with NEXT_PUBLIC_) ===
# Same URL the browser sees, but without the public prefix so n8n Code nodes
# (which don't bundle Next's NEXT_PUBLIC_* env) can read it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# === Telegram ===
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=cofre_bot
TELEGRAM_BOT_TOKEN= # from @BotFather
TELEGRAM_LOGIN_BOT_ID= # numeric id, from @userinfobot on your bot
TELEGRAM_WEBHOOK_SECRET= # openssl rand -hex 32

# === Session JWT secret (independent of Telegram webhook) ===
SESSION_SECRET= # openssl rand -hex 32 (different to TELEGRAM_WEBHOOK_SECRET in prod)

# === n8n (next → n8n notify path) ===
N8N_WEBHOOK_INGRESS_URL=https://n8n.example.com/webhook/cofre-notify
N8N_SHARED_SECRET= # openssl rand -hex 32 (must equal what you put in n8n workflow env)

# === AI providers ===
GROQ_API_KEY=gsk_...        # https://console.groq.com (free)
ANTHROPIC_API_KEY=sk-ant-... # https://console.anthropic.com

# === TTS ===
GOOGLE_TTS_API_KEY=AIza... # https://console.cloud.google.com → enable Cloud Text-to-Speech API

# === Site URL (used for invite links etc.) ===
NEXT_PUBLIC_SITE_URL=https://cofre.example.app
