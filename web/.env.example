# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_URL=                     # same value as NEXT_PUBLIC_SUPABASE_URL; n8n Code nodes can't read NEXT_PUBLIC_*

# Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=               # server-only
TELEGRAM_LOGIN_BOT_ID=            # bot id used by @telegram-login widget (numeric)
TELEGRAM_WEBHOOK_SECRET=          # random 32+ chars

# Session
SESSION_SECRET=                   # HMAC secret for our session JWT. Generate a different one to TELEGRAM_WEBHOOK_SECRET. Defaults to TELEGRAM_WEBHOOK_SECRET if unset (dev only).

# n8n (all used by n8n workflows directly + the next/api/notify route)
N8N_WEBHOOK_INGRESS_URL=          # full webhook path entry to n8n (next → n8n)
N8N_SHARED_SECRET=                # HMAC secret shared with n8n (= X-Cofre-Signature)

# AI
GROQ_API_KEY=                     # Whisper STT (free tier)
ANTHROPIC_API_KEY=                # intent extraction + confirmation writing

# TTS
GOOGLE_TTS_API_KEY=               # free quota 4M chars/mo, falls back to Edge TTS

# Vercel
NEXT_PUBLIC_SITE_URL=             # e.g. https://cofre.app

