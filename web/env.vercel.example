# Vercel-deploy env template (Production + Preview)
# Use: cd web && vercel env add <NAME> production
#      (repeat for Preview when you create a branch deployment)

# === Supabase (PUBLIC — safe to ship to client because of RLS) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# === Supabase (server — never prefix with NEXT_PUBLIC_) ===
# Same URL the browser sees, but without the public prefix so external
# services that read SUPABASE_URL don't need to be NEXT_PUBLIC_-aware.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# === Telegram ===
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=cofre_bot
TELEGRAM_BOT_TOKEN= # from @BotFather
TELEGRAM_LOGIN_BOT_ID= # numeric id (@userinfobot can give you this for your bot)
TELEGRAM_WEBHOOK_SECRET= # openssl rand -hex 32

# === Session JWT secret (independent of Telegram webhook in prod) ===
SESSION_SECRET= # openssl rand -hex 32 (different to TELEGRAM_WEBHOOK_SECRET in prod)

# === AI providers ===
OPENROUTER_API_KEY=sk-or-...     # https://openrouter.ai; powers the intent extractor

# === Site URL (used for invite links + 'welcome to cofre' messages) ===
NEXT_PUBLIC_SITE_URL=https://cofre.example.app

# === Optional MCP tooling (developer-local, NOT Vercel production) ===
# Set in the developer's shell, not Vercel:
#   export N8N_MCP_URL=https://<your-host>/mcp-server/http
#   export N8N_MCP_TOKEN=...    # paste only via /dev/stdin, never in argv

# === v0.2 placeholders (not used yet) ===
# GROQ_API_KEY=gsk_...              # for Groq Whisper STT (audio entry once returned)
# GOOGLE_TTS_API_KEY=AIza...       # for Google Cloud TTS (voice reply once returned)
