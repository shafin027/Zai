# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_URL=                     # same value as NEXT_PUBLIC_SUPABASE_URL; useful when an external service needs it

# Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=               # server-only
TELEGRAM_LOGIN_BOT_ID=            # bot id used by @telegram-login widget (numeric)
TELEGRAM_WEBHOOK_SECRET=          # random 32+ chars; HMAC verifies the inbound @ /api/telegram-webhook

# Session
SESSION_SECRET=                   # HMAC secret for the session JWT. Falls back to TELEGRAM_WEBHOOK_SECRET in dev only.

# AI
OPENROUTER_API_KEY=               # https://openrouter.ai (free models incl. anthropic/claude-sonnet-4.5)

# n8n (v0.2 voice entry/reply). If empty, the website keeps working in v0.1 text-only mode.
N8N_WEBHOOK_INGRESS_URL=          # e.g. https://<your-n8n-host> ; cofre-notify lives at <ingress>/webhook/cofre-notify
N8N_SHARED_SECRET=                # same secret as the N8N_SHARED_SECRET env in the n8n workflows (HMAC). If empty, falls back to in-process Telegram text.

# TTS / STT — used inside the n8n workflows, not on Vercel.
# Set these inside n8n's workflow variables (recommended) or as runtime env.
# GROQ_API_KEY=                   # Whisper STT (free)
# GOOGLE_TTS_API_KEY=              # Google TTS

# Vercel
NEXT_PUBLIC_SITE_URL=             # e.g. https://cofre.app
